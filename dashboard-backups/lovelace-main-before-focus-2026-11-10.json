     "secondary": "{% if states('sensor.tnvr_machine_state') == 'run' %}\n  {{ states('sensor.tnvr_oven_mode') }} · {{ states('sensor.tnvr_temperature') }}°C → {{ states('sensor.tnvr_setpoint') }}°C\n{% else %}\n  כבוי\n{% endif %}",
     "icon": "mdi:stove",
     "icon_color": "{% if states('sensor.tnvr_machine_state') == 'run' %}orange{% else %}grey{% endif %}",
     "fill_container": true,
     "tap_action": {
      "action": "more-info",
      "entity": "sensor.tnvr_machine_state"
     },
     "card_mod": {
      "style": "ha-card {\n  background: {{ 'linear-gradient(135deg, rgba(255,152,0,0.22), rgba(255,152,0,0.06))' if states('sensor.tnvr_machine_state') == 'run' else 'rgba(40,40,40,0.7)' }} !important;\n  border: {{ '1.5px solid rgba(255,152,0,0.5)' if states('sensor.tnvr_machine_state') == 'run' else '1px solid rgba(255,255,255,0.06)' }} !important;\n  border-radius: 22px !important;\n  box-shadow: {{ '0 6px 24px rgba(255,152,0,0.3)' if states('sensor.tnvr_machine_state') == 'run' else '0 2px 8px rgba(0,0,0,0.25)' }} !important;\n  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;\n  padding: 8px !important;\n}\nmushroom-shape-icon {\n  {% if states('sensor.tnvr_machine_state') == 'run' %}\n  animation: heat 2s ease-in-out infinite;\n  {% endif %}\n}\n@keyframes heat {\n  0%, 100% { transform: scale(1); filter: drop-shadow(0 0 4px rgba(255,152,0,0.6)); }\n  50% { transform: scale(1.08); filter: drop-shadow(0 0 12px rgba(255,152,0,0.9)); }\n}\n"
     }
    },
