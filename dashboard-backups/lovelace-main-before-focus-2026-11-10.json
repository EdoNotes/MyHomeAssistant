     },
     "fill_container": true,
     "card_mod": {
      "style": "ha-card {\n  background: linear-gradient(135deg, rgba(33,150,243,0.28), rgba(33,150,243,0.1)) !important;\n  border: 1.5px solid rgba(33,150,243,0.5) !important;\n  border-radius: 22px !important;\n  box-shadow: 0 4px 18px rgba(33,150,243,0.3) !important;\n}\n"
     }
    }
   ]
