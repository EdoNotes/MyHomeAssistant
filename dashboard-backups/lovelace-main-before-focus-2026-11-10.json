  {
   "title": "שואב",
   "path": "vacuum",
   "icon": "mdi:robot-vacuum",
   "cards": [
    {
     "type": "custom:mushroom-template-card",
     "primary": "Saros 20 · {{ states('sensor.saros_20_complete_status') }}",
     "secondary": "סוללה: {{ states('sensor.saros_20_complete_battery') }}%{% if is_state('binary_sensor.saros_20_complete_dock_mop_drying', 'on') %} · מייבש מגב {{ states('sensor.saros_20_complete_dock_mop_drying_remaining_time') | round(0) }} דק'{% endif %}",
     "icon": "mdi:robot-vacuum",
     "icon_color": "{% if is_state('binary_sensor.saros_20_complete_cleaning', 'on') %}\n  green\n{% elif is_state('binary_sensor.saros_20_complete_charging', 'on') %}\n  blue\n{% else %}\n  grey\n{% endif %}",
     "fill_container": true,
     "tap_action": {
      "action": "more-info",
      "entity": "vacuum.saros_20_complete"
     }
    },
    {
     "type": "conditional",
     "conditions": [
      {
       "entity": "vacuum.saros_20_complete",
       "state": "cleaning"
      }
     ],
     "card": {
      "type": "custom:vacuum-card",
      "entity": "vacuum.saros_20_complete",
      "map": "image.slvn_saros_20_complete_map_1",
      "map_refresh": 2,
      "show_name": true,
      "show_status": true,
      "show_toolbar": true,
      "compact_view": false,
      "stats": {
       "default": [
        {
         "attribute": "battery_level",
         "unit": "%",
         "subtitle": "Battery"
        }
       ],
       "cleaning": [
        {
         "entity": "sensor.saros_20_complete_cleaning_area",
         "unit": "מ״ר",
         "subtitle": "שטח"
        },
        {
         "entity": "sensor.saros_20_complete_cleaning_time",
         "unit": "דק׳",
         "subtitle": "זמן"
        },
        {
         "entity": "sensor.saros_20_complete_current_room",
         "subtitle": "חדר"
        }
       ]
      },
      "shortcuts": [
       {
        "name": "Send to Base",
        "service": "vacuum.return_to_base",
        "service_data": {
         "entity_id": "vacuum.saros_20_complete"
        },
        "icon": "mdi:home"
       }
      ]
     }
    },
    {
     "type": "conditional",
     "conditions": [
      {
       "entity": "vacuum.saros_20_complete",
       "state_not": "cleaning"
      }
     ],
     "card": {
      "type": "custom:vacuum-card",
      "entity": "vacuum.saros_20_complete",
      "show_name": true,
      "show_status": true,
      "show_toolbar": true,
      "compact_view": false,
      "stats": {
       "default": [
        {
         "attribute": "battery_level",
         "unit": "%",
         "subtitle": "Battery"
        },
        {
         "entity": "sensor.saros_20_complete_total_cleaning_count",
         "subtitle": "ניקויים"
        }
       ]
      },
      "shortcuts": [
       {
        "name": "Send to Base",
        "service": "vacuum.return_to_base",
        "service_data": {
         "entity_id": "vacuum.saros_20_complete"
        },
        "icon": "mdi:home"
       }
      ]
     }
    },
    {
     "type": "horizontal-stack",
     "cards": [
      {
       "type": "tile",
       "entity": "select.saros_20_complete_cleaning_mode",
       "name": "עוצמת שאיבה",
