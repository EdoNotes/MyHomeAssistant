  {
   "title": "דוד מים",
   "path": "boiler",
   "icon": "mdi:water-boiler",
   "cards": [
    {
     "type": "custom:mushroom-template-card",
     "primary": "דוד מים",
     "secondary": "{% if is_state('switch.notes_boiler', 'on') %}\n  פועל - נותרו {{ states('sensor.notes_boiler_remaining_time') }} דק'\n{% else %}\n  כבוי\n{% endif %}",
     "icon": "mdi:water-boiler",
     "icon_color": "{{ 'blue' if is_state('switch.notes_boiler', 'on') else 'grey' }}",
     "tap_action": {
      "action": "call-service",
      "service": "switch.toggle",
      "target": {
       "entity_id": "switch.notes_boiler"
      },
      "haptic": "medium"
     },
     "hold_action": {
      "action": "more-info"
     },
     "fill_container": true,
     "card_mod": {
      "style": "ha-card {\n  background: {{ 'linear-gradient(135deg, rgba(33,150,243,0.22), rgba(33,150,243,0.06))' if is_state('switch.notes_boiler', 'on') else 'rgba(40,40,40,0.7)' }} !important;\n  border: {{ '1.5px solid rgba(33,150,243,0.5)' if is_state('switch.notes_boiler', 'on') else '1px solid rgba(255,255,255,0.06)' }} !important;\n  border-radius: 22px !important;\n  box-shadow: {{ '0 6px 24px rgba(33,150,243,0.3)' if is_state('switch.notes_boiler', 'on') else '0 2px 8px rgba(0,0,0,0.25)' }} !important;\n  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;\n}\n"
     }
    },
    {
     "type": "tile",
     "entity": "input_number.boiler_timer_minutes",
     "name": "זמן הפעלה",
     "icon": "mdi:timer-outline",
     "features": [
      {
       "type": "numeric-input"
      }
     ],
     "card_mod": {
      "style": "ha-card {\n  border-radius: 22px !important;\n  background: rgba(40,40,40,0.7) !important;\n  border: 1px solid rgba(255,255,255,0.06) !important;\n}\n"
     }
    },
    {
     "type": "custom:mushroom-template-card",
     "primary": "הפעל דוד",
     "secondary": "{{ states('input_number.boiler_timer_minutes') | int }} דקות",
     "icon": "mdi:play-circle",
