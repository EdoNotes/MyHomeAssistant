     "secondary": "{% set b = states('sensor.roborock_f25_ace_combo_battery') %}{% if b in ['unavailable', 'unknown'] %}—{% else %}סוללה: {{ b }}%{% endif %}",
     "icon": "mdi:vacuum",
     "icon_color": "{% if states('sensor.roborock_f25_ace_combo_status') in ['unavailable', 'unknown'] %}grey{% elif is_state('sensor.roborock_f25_ace_combo_error', 'none') %}green{% else %}red{% endif %}",
     "fill_container": true,
     "tap_action": {
      "action": "more-info",
      "entity": "sensor.roborock_f25_ace_combo_status"
     }
    }
