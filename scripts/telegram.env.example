# Copy to telegram.env and fill in your values. telegram.env is not committed (add to .gitignore).
# Get bot token: message @BotFather on Telegram, /newbot, then copy the token.
# Get chat id: message your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates and look for "chat":{"id": ...}

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjkLMNopqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
